# Скопируйте этот файл в .env (cp .env.example .env) и подставьте свои данные,
# чтобы приложение подключалось к PostgreSQL вместо локального SQLite.
# Без .env (или без переменной DATABASE_URL внутри) приложение как и раньше
# использует data/stroymaterialy.db.
#
# Формат: postgresql+psycopg2://<пользователь>:<пароль>@<хост>:<порт>/<база>
DATABASE_URL=postgresql+psycopg2://stroymaterialy:stroymaterialy@localhost:5432/stroymaterialy
