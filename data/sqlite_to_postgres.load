-- pgloader-скрипт миграции data/stroymaterialy.db (SQLite) в PostgreSQL.
-- Запуск (из корня проекта, после того как SQLite-БД наполнена):
--   pgloader data/sqlite_to_postgres.load
--
-- Перед запуском база stroymaterialy и пользователь stroymaterialy должны
-- существовать в PostgreSQL (см. раздел "Переход на PostgreSQL" в README.md).
-- Если меняете логин/пароль/хост/имя базы — поправьте и здесь, и в .env.

LOAD DATABASE
     FROM sqlite:///data/stroymaterialy.db
     INTO postgresql://stroymaterialy:stroymaterialy@localhost:5432/stroymaterialy

WITH include drop, create tables, create indexes, reset sequences,
     downcase identifiers

SET work_mem to '16MB', maintenance_work_mem to '512 MB'

CAST type datetime to timestamptz drop default drop not null using zero-dates-to-null;
